# sdkconfig.defaults - what every build of the Fractonica clock starts from.
# ESP-IDF reads this file, then sdkconfig.defaults.<target>, when it creates
# an sdkconfig. Hardware choices are NOT here: they are the defaults of
# main/Kconfig.projbuild ("Fractonica clock" in menuconfig), and a variant
# is a file in configs/ added with -DSDKCONFIG_DEFAULTS (tools/build-all.sh).

# Compact: optimise for size (the owner's word for embedded: "compact").
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# 1 ms ticks: the UI task's deadlines and the button timing are in
# milliseconds; with the default 10 ms tick a redraw could be 10 ms late and
# a debounce time could not be shorter than 20 ms.
CONFIG_FREERTOS_HZ=1000

# The task watchdog stays on (ESP-IDF's default) and watches the idle tasks:
# no task of ours may spin. Written out because the firmware relies on it.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y

# app_main only starts things; the UI task has its own static stack
# (CONFIG_FRACTONICA_UI_STACK).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# 4 MB of flash: what the development kits of all three chips carry at least
# (and what PlatformIO's board files expect). The image is about 0.32 MB
# (0.85 MB with Wi-Fi) in the default 1 MB application partition. For a 2 MB
# module: menuconfig -> Serial flasher config -> Flash size.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
