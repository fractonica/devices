# ESP32-C6, e.g. ESP32-C6-DevKitC-1 / -M-1. RISC-V, single core at 160 MHz, 512 kB of RAM.
# SPI2 is the only general-purpose SPI host. The console is the built-in USB-Serial-JTAG
# (the board's "USB" port); pins are chosen per board in configs/*.defaults.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
