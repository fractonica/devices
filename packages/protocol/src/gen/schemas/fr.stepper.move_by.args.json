{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fractonica:schema:fr.stepper.move_by.args",
  "title": "fr.stepper.move_by arguments",
  "description": "Moves by `steps` from the running move's target, or from the position when no move runs. move_to's answers; 0 steps at rest is done (reached) at once.",
  "type": "object",
  "properties": {
    "steps": {
      "type": "integer",
      "minimum": -1000000000,
      "maximum": 1000000000,
      "description": "(-1000000000..1000000000)"
    },
    "speed_hz": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "description": "absent: max_speed_hz (Hz; 1..10000)"
    },
    "accel": {
      "type": "integer",
      "minimum": 10,
      "maximum": 200000,
      "description": "absent: the configured accel (Hz/s; 10..200000)"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "steps": 160
    },
    {
      "steps": -20,
      "speed_hz": 200
    }
  ]
}
