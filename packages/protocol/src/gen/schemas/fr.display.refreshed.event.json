{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fractonica:schema:fr.display.refreshed.event",
  "title": "fr.display.refreshed event",
  "description": "An e-paper refresh ended. x, y, w, h: the area that changed (the whole screen for fast and full); ok false when the panel did not finish in time (the next refresh is full); crc: what the glass shows now (shown_crc).",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "auto",
        "partial",
        "fast",
        "full"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "(ms)"
    },
    "partials": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "x": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "(px)"
    },
    "y": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "(px)"
    },
    "w": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "(px)"
    },
    "h": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "(px)"
    },
    "crc": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  },
  "additionalProperties": false
}
